    <TextView android:text="Test your knowledge with 10 random questions. Questions shuffle every time!" android:gravity="center" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnStart" android:text="Start Quiz" android:textSize="18sp" android:layout_marginTop="32dp" android:layout_width="match_parent" android:layout_height="60dp"/>
</LinearLayout>
